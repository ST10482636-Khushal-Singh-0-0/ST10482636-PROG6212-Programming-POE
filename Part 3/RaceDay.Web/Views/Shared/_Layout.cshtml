@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAFC; color: #1E293B; }
        h1, h2, h3, .navbar-brand { font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.5px; }
        .navbar-raceday { background-color: #0F172A; border-bottom: 3px solid #F97316; }
        .btn-raceday { background-color: #F97316; color: #fff; font-weight: 600; border: none; }
        .btn-raceday:hover { background-color: #EA580C; color: #fff; }
        .badge-confirmed { background-color: #16A34A; color: #fff; }
        .badge-pending { background-color: #D97706; color: #fff; }
        .badge-cancelled { background-color: #DC2626; color: #fff; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-raceday shadow-sm">
            <div class="container">
                <a class="navbar-brand fs-3 fw-bold text-white" asp-controller="Home" asp-action="Index">
                    RACE<span style="color:#F97316;">DAY</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Upcoming Events</a>
                        </li>
                        @if (role == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Organiser Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">Create Event</a>
                            </li>
                        }
                        else if (role == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="Profile">My Profile</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (!string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item me-3 text-light small">
                                <span class="badge bg-secondary me-1">@role</span> @userName
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-raceday btn-sm px-3" asp-controller="Account" asp-action="Register">Join Now</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>