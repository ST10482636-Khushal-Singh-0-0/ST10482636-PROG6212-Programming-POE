@model RaceDay.Web.Models.ProfileViewModel
@{ ViewData["Title"] = "My Profile"; }

<h1 class="fw-bold mb-4">My Athlete Profile</h1>
<div class="row">
    <div class="col-md-4 text-center mb-3">
        <div class="card border-0 shadow-sm p-4">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" class="rounded-circle mx-auto mb-3" style="width: 150px; height: 150px; object-fit: cover;" alt="Profile Picture" />
            }
            else
            {
                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 150px; height: 150px; font-size: 2.5rem;">
                    @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                </div>
            }
            <h5 class="fw-bold mb-0">@Model.FullName</h5>
            <p class="text-muted small">@Model.Email</p>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card border-0 shadow-sm p-4">
            <form asp-action="Profile" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="ProfilePicture" class="form-label">Upload Profile Picture (Azure Blob Storage)</label>
                    <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" />
                </div>
                <button type="submit" class="btn btn-raceday px-4">Update Profile</button>
            </form>
        </div>
    </div>
</div>