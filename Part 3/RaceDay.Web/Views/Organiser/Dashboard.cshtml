@model List<RaceDay.Web.Models.EventViewModel>
@{ ViewData["Title"] = "Organiser Dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold mb-0">Organiser Dashboard</h1>
    <a asp-action="CreateEvent" class="btn btn-raceday">+ Create New Event</a>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Location</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td class="fw-bold">@ev.Name</td>
                    <td>@ev.Date.ToString("dd MMM yyyy")</td>
                    <td>@ev.Location</td>
                    <td>@ev.EventType (@ev.Distance)</td>
                    <td>
                        <a asp-action="EditEvent" asp-route-id="@ev.EffectiveId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="ManageCategories" asp-route-eventId="@ev.EffectiveId" class="btn btn-sm btn-outline-secondary">Categories</a>
                        <a asp-action="EventEnrolments" asp-route-eventId="@ev.EffectiveId" class="btn btn-sm btn-outline-info">Enrolments</a>
                        <a asp-action="CaptureResults" asp-route-eventId="@ev.EffectiveId" class="btn btn-sm btn-outline-success">Results</a>
                        <form asp-action="DeleteEvent" asp-route-id="@ev.EffectiveId" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>