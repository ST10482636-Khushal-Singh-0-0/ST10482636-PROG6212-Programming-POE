@model List<RaceDay.Web.Models.EnrolmentViewModel>
@{ ViewData["Title"] = "Capture Results"; }

<h1 class="fw-bold mb-4">Capture &amp; Publish Race Results</h1>
<div class="bg-white rounded shadow-sm p-3">
    <table class="table align-middle mb-0">
        <thead class="table-dark">
            <tr><th>Participant</th><th>Category</th><th>Finish Time (HH:MM:SS)</th><th>Position</th><th>Action</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.ParticipantName</td>
                    <td>@e.CategoryName</td>
                    <td colspan="3">
                        <form asp-action="PublishResult" method="post" class="row g-2">
                            <input type="hidden" name="eventId" value="@ViewBag.EventId" />
                            <input type="hidden" name="enrolmentId" value="@e.EffectiveId" />
                            <div class="col-md-5">
                                <input type="text" name="finishTime" class="form-control form-control-sm" placeholder="01:35:20" required />
                            </div>
                            <div class="col-md-4">
                                <input type="number" name="position" class="form-control form-control-sm" placeholder="1" min="1" required />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-sm btn-raceday w-100">Publish</button>
                            </div>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<a asp-action="Dashboard" class="btn btn-outline-dark mt-3">Back to Dashboard</a>