@model List<RaceDay.Web.Models.EnrolmentViewModel>
@{ ViewData["Title"] = "Event Enrolments"; }

<h1 class="fw-bold mb-4">Enrolled Participants</h1>
<div class="bg-white rounded shadow-sm p-3">
    <table class="table mb-0">
        <thead class="table-dark">
            <tr><th>Participant</th><th>Category</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.ParticipantName</td>
                    <td>@e.CategoryName</td>
                    <td><span class="badge badge-confirmed">@e.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<a asp-action="Dashboard" class="btn btn-outline-dark mt-3">Back to Dashboard</a>