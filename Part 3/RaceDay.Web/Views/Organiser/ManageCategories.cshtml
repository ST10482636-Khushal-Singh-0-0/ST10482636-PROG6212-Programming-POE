@model List<RaceDay.Web.Models.CategoryViewModel>
@{ ViewData["Title"] = "Manage Categories"; }

<h1 class="fw-bold mb-4">Manage Event Categories</h1>

<div class="card border-0 shadow-sm p-4 mb-4">
    <h5 class="fw-bold mb-3">Add New Category</h5>
    <form asp-action="AddCategory" method="post" class="row g-3">
        <input type="hidden" name="EventId" value="@ViewBag.EventId" />
        <div class="col-md-4">
            <input type="text" name="Name" class="form-control" placeholder="Category Name (e.g. Open Men)" required />
        </div>
        <div class="col-md-3">
            <input type="text" name="Distance" class="form-control" placeholder="Distance (e.g. 21km)" />
        </div>
        <div class="col-md-3">
            <input type="text" name="AgeGroup" class="form-control" placeholder="Age Group (e.g. 18-39)" />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-raceday">Add</button>
        </div>
    </form>
</div>

<div class="bg-white rounded shadow-sm p-3">
    <table class="table mb-0">
        <thead class="table-dark">
            <tr><th>Category</th><th>Distance</th><th>Age Group</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr><td>@c.Name</td><td>@c.Distance</td><td>@c.AgeGroup</td></tr>
            }
        </tbody>
    </table>
</div>
<a asp-action="Dashboard" class="btn btn-outline-dark mt-3">Back to Dashboard</a>