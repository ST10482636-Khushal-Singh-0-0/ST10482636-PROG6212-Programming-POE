@model List<RaceDay.Web.Models.EventViewModel>
@{ ViewData["Title"] = "Upcoming Events"; }

<div class="p-4 p-md-5 mb-4 rounded text-white shadow-sm" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); border-left: 6px solid #F97316;">
    <h1 class="display-4 fw-bold">Find Your Next Starting Line</h1>
    <p class="lead mb-0">Browse marathons, cycling tours, trail runs, and triathlons across South Africa.</p>
</div>

@if (ViewBag.ApiError != null)
{
    <div class="alert alert-warning">@ViewBag.ApiError</div>
}

<form method="get" class="row g-2 mb-4 bg-white p-3 rounded shadow-sm">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search event name..." />
    </div>
    <div class="col-md-3">
        <input type="text" name="eventType" value="@ViewBag.EventType" class="form-control" placeholder="Type (e.g. Marathon, Cycling)" />
    </div>
    <div class="col-md-3">
        <input type="text" name="location" value="@ViewBag.Location" class="form-control" placeholder="Location..." />
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-raceday">Filter Events</button>
    </div>
</form>

<div class="row g-4">
    @foreach (var ev in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                {
                    <img src="@ev.BannerImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@ev.Name" />
                }
                else
                {
                    <div class="bg-dark text-white d-flex align-items-center justify-content-center" style="height: 180px;">
                        <span class="fs-4 fw-bold text-uppercase">@ev.EventType</span>
                    </div>
                }
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>@ev.EventType</span>
                        <span>@ev.Date.ToString("dd MMM yyyy")</span>
                    </div>
                    <h4 class="card-title fw-bold">@ev.Name</h4>
                    <p class="card-text text-muted small mb-3">@ev.Location &bull; @ev.Distance</p>
                    <a asp-action="EventDetails" asp-route-id="@ev.EffectiveId" class="btn btn-raceday mt-auto">View &amp; Enrol</a>
                </div>
            </div>
        </div>
    }
</div>